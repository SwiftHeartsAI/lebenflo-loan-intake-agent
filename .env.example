# Copy to .env and fill in. Never commit .env.

# offline = replay data/recorded/ (no Azure needed)
# live    = call Azure and record responses to data/recorded/
LEBENFLO_MODE=offline

# Azure AI Document Intelligence (Keys and Endpoint page of the resource)
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# Azure OpenAI via Azure AI Foundry (chat + embeddings deployments)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure AI Search (free tier): vector + keyword index over the lending policy
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=lebenflo-policy

# Azure SQL Database (free offer): warehouse for intake results
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=lebenflo
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# Arize Phoenix (local). Leave blank to disable tracing.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
